{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.dev/schemas/task.schema.json",
  "title": "AutoDev Task",
  "description": "A durable unit of software-engineering work managed by the orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "priority", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "planning", "ready", "running", "verifying", "blocked", "completed", "failed", "cancelled"]
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "parent_id": { "type": ["string", "null"] },
    "agent_id": { "type": ["string", "null"] },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
