{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AMX Memory Record Schema v1",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "content_lifecycle",
    "admission",
    "validity",
    "provenance_digest",
    "author_attestation",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "amx.record.v1"
      ]
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "CLAIM",
        "SUMMARY",
        "DECISION",
        "CONFIG_CANDIDATE"
      ]
    },
    "content_lifecycle": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "CURRENT",
        "SUPERSEDED",
        "RETRACTED"
      ]
    },
    "admission": {
      "type": "string",
      "enum": [
        "UNASSESSED",
        "QUARANTINED",
        "ADMITTED",
        "REJECTED"
      ]
    },
    "validity": {
      "type": "string",
      "enum": [
        "VALID",
        "STALE",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "causal_parent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "author_attestation": {
      "type": "object",
      "required": [
        "principal_id",
        "role",
        "timestamp"
      ],
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "title",
        "content"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}