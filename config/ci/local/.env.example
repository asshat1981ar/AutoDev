# AutoDev Local Development Environment Configuration
# This file is a template for local development environment variables.
# 
# Usage:
#   1. Copy this file to config/local/.env
#   2. Customize the values for your local environment
#   3. Source it: source config/local/.env
#
# This file is in .gitignore and should NOT be committed.
#
# Priority: Local .env > This template > System defaults

# =============================================================================
# RUST CONFIGURATION
# =============================================================================

# Rust toolchain (default: stable)
export RUSTUP_TOOLCHAIN=stable

# Cargo configuration
export CARGO_TERM_COLOR=always

# Enable incremental builds for local development
export CARGO_INCREMENTAL=true

# =============================================================================
# KOTLIN / GRADLE CONFIGURATION
# =============================================================================

# Enable Gradle daemon for faster local builds
export GRADLE_OPTS="-Dorg.gradle.daemon=true"

# JDK home (adjust for your system)
export JDK_17_HOME=$JAVA_HOME

# Android SDK (only if building APK)
export ANDROID_HOME=$HOME/Android/Sdk
export ANDROID_NDK_HOME=$HOME/Android/Sdk/ndk

# =============================================================================
# PYTHON CONFIGURATION
# =============================================================================

# Python version
export PYTHON_VERSION=3.11

# Virtual environment
export VENV_PATH=.venv

# =============================================================================
# NODE CONFIGURATION
# =============================================================================

# Node version
export NODE_VERSION=24

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# AutoDev server port
export AUTODEV_PORT=8080

# Development mode
export AUTODEV_ENV=development

# =============================================================================
# GITHUB WEBHOOK (for local testing only)
# =============================================================================

# Generate with: openssl rand -hex 32
export GITHUB_WEBHOOK_SECRET=your_dev_secret_here

# =============================================================================
# MCP CONFIGURATION (for local development)
# =============================================================================

# Bearer token for MCP authentication (dev only)
export AUTODEV_MCP_BEARER_TOKEN=your_dev_token_here

# Allowed hosts for MCP connections
export AUTODEV_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (debug, info, warn, error)
export AUTODEV_LOG_LEVEL=debug

# Enable verbose output
export AUTODEV_VERBOSE=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable experimental features
export AUTODEV_EXPERIMENTAL=false

# Enable detailed profiling
export AUTODEV_PROFILING=false

# =============================================================================
# EDITOR / IDE CONFIGURATION
# =============================================================================

# Editor configuration file
export EDITORCONFIG=config/defaults/common/.editorconfig

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker build cache
export DOCKER_BUILDKIT=1

# =============================================================================
# SECURITY WARNING
# =============================================================================

# WARNING: Do NOT use production secrets in local development!
# Production secrets should only be configured in GitHub Actions.
#
# The following are PRODUCTION secrets and should NOT be in this file:
# - Production GITHUB_WEBHOOK_SECRET
# - Production MCP tokens
# - Container registry credentials
# - Any secrets from production environments

# For production secrets, use:
# - GitHub Actions secrets (CI)
# - Secure secret managers (local production deployments)
# - Environment-specific .env files that are NEVER committed
